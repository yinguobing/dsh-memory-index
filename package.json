{
  "name": "dsh-memory-index",
  "version": "0.1.0",
  "description": "Full-text memory index for DeepSeek Harness: search an existing Markdown memory tree with SQLite FTS5, without migrating files or running an embedding service.",
  "license": "MIT",
  "author": "Yin Guobing",
  "homepage": "https://github.com/yinguobing/dsh-memory-index#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yinguobing/dsh-memory-index.git"
  },
  "bugs": {
    "url": "https://github.com/yinguobing/dsh-memory-index/issues"
  },
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "markdown",
    "sqlite",
    "fts5",
    "search",
    "chinese"
  ],
  "scripts": {
    "test": "node --test",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
